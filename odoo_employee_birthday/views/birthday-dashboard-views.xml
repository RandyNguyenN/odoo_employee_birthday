<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- OWL client action for the birthday dashboard -->
    <record id="action_employee_birthday_dashboard" model="ir.actions.client">
        <field name="name">Birthday Dashboard</field>
        <field name="tag">odoo_employee_birthday.BirthdayDashboard</field>
    </record>

    <!-- Standard list view for all employees with birthdays -->
    <record id="action_employee_birthday_list" model="ir.actions.act_window">
        <field name="name">All Birthdays</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('active', '=', True), ('birthday', '!=', False)]</field>
    </record>
</odoo>
